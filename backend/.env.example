DEBUG=true
LOCAL_MODE=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DEBUG=false, LOCAL_MODE=false, PostgreSQL URL with ?sslmode=require
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DELIVERY_PINCODES=390001,390002,390005,390007,390020
DELIVERY_FEE_PAISE=4000
TAX_BASIS_POINTS=500
PRINTER_HOST=
PRINTER_PORT=9100
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Set true only behind a trusted HTTPS reverse proxy such as Render.
TRUST_PROXY_SSL_HEADER=false
# Enable these only when you control the domain and every subdomain supports HTTPS.
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Render provides this automatically for its default domain.
# RENDER_EXTERNAL_HOSTNAME=baroda-fry-web.onrender.com
